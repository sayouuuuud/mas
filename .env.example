# Configure these in the hosting environment. Never commit actual values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SITE_URL=
# At least 32 random characters each; use separate values.
RATE_LIMIT_SECRET=
CRON_SECRET=
# Default: external antivirus required. Explicit validation_only enables structural
# validation/image re-encoding without an external antivirus service.
MEDIA_SCAN_MODE=required
# Used when MEDIA_SCAN_MODE=required.
MEDIA_SCANNER_URL=
MEDIA_SCANNER_KEY=
# Optional, one-time owner initialization script; existing Supabase Auth UUID.
OWNER_USER_ID=
OWNER_DISPLAY_NAME=
